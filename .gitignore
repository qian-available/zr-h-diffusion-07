# VASP licensed potential: keep only its identity/hash in tracked manifests.
**/POTCAR
**/POTCAR.gz
**/POTCAR.Z

# Large restart files; current NEB inputs disable their generation.
**/WAVECAR
**/CHGCAR

# HDF5 output may embed the complete licensed POTCAR.
**/vaspout.h5
**/vaspin.h5
**/vaspwave.h5

# Regenerable Python cache.
**/__pycache__/
*.pyc

# Local paper PDFs and extracted figures used for literature review.
/literature_materials/

# Local project documentation and version-control notes.
/doc/
/VERSION_CONTROL.md

# Temporary downloads.
/tmp/
